# 站点链接（部署到自定义域名时可选，默认 resume-optimization.top）
# NEXT_PUBLIC_PORTFOLIO_URL=https://www.resume-optimization.top
# NEXT_PUBLIC_APP_URL=https://app.resume-optimization.top

# LLM API Key（必填，任选其一）
LLM_API_KEY=your_api_key_here
# OPENAI_API_KEY=your_openai_key
# DEEPSEEK_API_KEY=your_deepseek_key

# API 地址（默认 DeepSeek）
LLM_BASE_URL=https://api.deepseek.com

# 模型名称（默认 deepseek-chat）
LLM_MODEL=deepseek-chat

# 评委模型（eval:judge 用，建议与优化模型不同以便校准 Rubric）
# JUDGE_LLM_API_KEY=your_judge_api_key
# JUDGE_LLM_BASE_URL=https://api.openai.com/v1
# JUDGE_LLM_MODEL=gpt-4o-mini

# OCR 配置（扫描版 PDF / 图片简历）
# auto = Vercel 自动用 cloud，本地自动用 local
OCR_PROVIDER=auto
OCR_ENABLED=true
OCR_MAX_PAGES=5
# 云端 OCR 视觉模型（SiliconFlow，部署到 Vercel 时使用）
OCR_VISION_MODEL=Pro/Qwen/Qwen2.5-VL-7B-Instruct

# 面试准备：联网调研（Tavily）
TAVILY_API_KEY=your_tavily_key
# 0 表示不限制；正整数为每 IP 每日上限
INTERVIEW_PREP_RATE_LIMIT=0
SEARCH_CACHE_TTL_SECONDS=86400
